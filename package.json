{
  "name": "tvc-rocket-baseline",
  "version": "0.1.0",
  "description": "Baseline repo for a TVC rocket (Phase 2) and the vane-controlled monocopter test vehicle (Phase 1): docs, three.js models, interactive tutorials, firmware.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test",
    "bom": "node scripts/gen-bom.mjs",
    "screenshots": "node scripts/screenshot.mjs",
    "audit": "node scripts/audit-ui.mjs",
    "test:firmware": "node scripts/test-firmware.mjs",
    "cad": "node scripts/gen-cad.mjs",
    "cad:check": "node scripts/gen-cad.mjs --check",
    "cad:assembly": "node scripts/check-assembly.mjs"
  },
  "devDependencies": {
    "manifold-3d": "^3.5.4",
    "puppeteer-core": "^23.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
